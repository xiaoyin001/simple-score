button {
  background: initial;
  box-sizing: border-box;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #fff8e6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: #3b260f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}
