page {
  background: #f4f5f7;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.room-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.room-name {
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.room-meta {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.copy-button,
.share-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  border-radius: 10rpx;
  background: #eef7f3;
  color: #1f7a5a;
  font-size: 24rpx;
  line-height: 1;
}

.status-bar {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff4e5;
  color: #955b12;
  font-size: 24rpx;
}

.score-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #1f7a5a;
  color: #ffffff;
}

.panel-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.public-score {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
}

.share-button {
  background: #ffffff;
  color: #1f7a5a;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.member-card {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.member-check {
  margin-right: 10rpx;
}

.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #f0f2f5;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 700;
}

.member-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.member-name {
  color: #111827;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  margin-top: 6rpx;
  color: #8b95a1;
  font-size: 22rpx;
}

.member-score {
  flex-shrink: 0;
  min-width: 80rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
  text-align: right;
}

.member-actions {
  display: flex;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.mini-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 10rpx;
  padding: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1;
}

.add {
  background: #e8f7ef;
  color: #137a4a;
}

.subtract {
  background: #fff0f0;
  color: #b42318;
}

.batch-actions,
.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.batch-button,
.footer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-left: 0;
  margin-right: 0;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1;
}

.transfer-card {
  padding: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.transfer-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.transfer-row:last-child {
  margin-bottom: 0;
}

.picker {
  flex: 1;
  min-width: 0;
}

.picker-value,
.transfer-input {
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  color: #111827;
  font-size: 25rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transfer-input {
  flex: 1;
}

.transfer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 150rpx;
  height: 76rpx;
  border-radius: 10rpx;
  background: #1f7a5a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.record-empty {
  padding: 28rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #8b95a1;
  font-size: 26rpx;
  text-align: center;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.record-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}

.record-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.record-right {
  flex-shrink: 0;
  margin-left: 14rpx;
  text-align: right;
}

.record-time {
  color: #8b95a1;
  font-size: 22rpx;
}

.undone {
  margin-top: 8rpx;
  color: #b42318;
  font-size: 22rpx;
}

.footer-button {
  background: #eef7f3;
  color: #1f7a5a;
}

.danger {
  background: #fff0f0;
  color: #b42318;
}

.loading {
  padding-top: 160rpx;
  color: #6b7280;
  font-size: 28rpx;
  text-align: center;
}
