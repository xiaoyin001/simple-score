page {
  background: #f4f5f7;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.room-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.room-name {
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.room-meta {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.copy-button,
.share-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  max-width: 100%;
  height: 58rpx;
  border-radius: 10rpx;
  background: #eef7f3;
  color: #1f7a5a;
  font-size: 24rpx;
  line-height: 1;
  box-sizing: border-box;
}

.batch-toggle {
  min-width: 132rpx;
  background: #d9f6e7;
  color: #126b45;
  border: 2rpx solid #95d8b5;
  font-weight: 700;
}

.batch-toggle.active {
  background: #1f7a5a;
  color: #ffffff;
  border-color: #1f7a5a;
}

.records-all-button {
  min-width: 120rpx;
  background: #e9f0ff;
  color: #1d4f91;
  border: 2rpx solid #b8ccf2;
  font-weight: 700;
}

.status-bar {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff4e5;
  color: #955b12;
  font-size: 24rpx;
}

.score-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #1f7a5a;
  color: #ffffff;
}

.panel-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.public-score {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
}

.share-button {
  background: #ffffff;
  color: #1f7a5a;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.member-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 104rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.member-info {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.member-check {
  margin-right: 10rpx;
}

.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #f0f2f5;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 700;
}

.member-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.member-name {
  color: #111827;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  margin-top: 6rpx;
  color: #8b95a1;
  font-size: 22rpx;
}

.member-score {
  flex-shrink: 0;
  min-width: 80rpx;
  font-size: 38rpx;
  font-weight: 700;
  text-align: right;
}

.score-positive {
  color: #12824f;
}

.score-negative {
  color: #c2412d;
}

.score-neutral {
  color: #111827;
}

.member-actions {
  display: flex;
  gap: 14rpx;
  width: 100%;
  margin-top: 18rpx;
}

.score-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0;
  padding: 0;
  height: 68rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.add {
  background: #dff5ea;
  color: #087443;
  border: 2rpx solid #a9dfc1;
}

.subtract {
  background: #fff0ed;
  color: #bf2f22;
  border: 2rpx solid #f3b8b0;
}

.batch-actions,
.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.batch-button,
.footer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-left: 0;
  margin-right: 0;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.transfer-card {
  padding: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.transfer-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.transfer-row:last-child {
  margin-bottom: 0;
}

.picker {
  flex: 1;
  min-width: 0;
}

.picker-value,
.transfer-input {
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  color: #111827;
  font-size: 25rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transfer-input {
  flex: 1;
}

.transfer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 150rpx;
  height: 76rpx;
  border-radius: 10rpx;
  background: #1f7a5a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.record-empty {
  padding: 28rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #8b95a1;
  font-size: 26rpx;
  text-align: center;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-item.record-positive {
  border-left-color: #1f9d63;
}

.record-item.record-negative {
  border-left-color: #d64532;
}

.record-item.record-transfer {
  border-left-color: #2f80c4;
}

.record-item.record-undo {
  border-left-color: #9ca3af;
}

.record-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}

.record-operator {
  margin-top: 6rpx;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 1.4;
}

.record-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.45;
}

.record-amount {
  margin-left: 10rpx;
  font-weight: 700;
}

.record-amount.record-positive {
  color: #12824f;
}

.record-amount.record-negative {
  color: #c2412d;
}

.record-amount.record-transfer {
  color: #2f80c4;
}

.record-amount.record-undo,
.record-amount.record-neutral {
  color: #6b7280;
}

.record-right {
  flex-shrink: 0;
  margin-left: 14rpx;
  text-align: right;
}

.record-time {
  color: #8b95a1;
  font-size: 22rpx;
}

.undone {
  margin-top: 8rpx;
  color: #b42318;
  font-size: 22rpx;
}

.undo-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 0 auto;
  padding: 0 18rpx;
  min-width: 96rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.record-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.pager-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  width: 132rpx;
  height: 54rpx;
  border-radius: 10rpx;
  background: #e9f0ff;
  color: #1d4f91;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.pager-button[disabled] {
  background: #eef0f3;
  color: #9ca3af;
}

.pager-text {
  min-width: 76rpx;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.footer-button {
  background: #eef7f3;
  color: #1f7a5a;
}

.danger {
  background: #fff0f0;
  color: #b42318;
}

.loading {
  padding-top: 160rpx;
  color: #6b7280;
  font-size: 28rpx;
  text-align: center;
}
