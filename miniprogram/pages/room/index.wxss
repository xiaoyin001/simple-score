page {
  background: #fffdf7;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  background-color: #fffdf7;
  background-image: linear-gradient(180deg, rgba(255, 225, 86, 0.42), rgba(255, 253, 247, 0.94) 360rpx);
  background-repeat: no-repeat;
  background-size: 100% 360rpx;
  box-sizing: border-box;
}

.room-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 30rpx rgba(111, 74, 28, 0.08);
}

.room-header-main {
  flex: 1;
  min-width: 0;
}

.room-name {
  overflow: hidden;
  color: #3b260f;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-meta {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #714911;
  font-size: 24rpx;
  font-weight: 800;
}

.sync-status {
  margin-top: 10rpx;
  color: #7b694c;
  font-size: 22rpx;
  line-height: 1.4;
}

.sync-ok {
  color: #1f7a5a;
}

.sync-pending {
  color: #8a6a12;
}

.sync-error {
  color: #b64d32;
}

.room-header-actions {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  align-items: flex-end;
  width: 96rpx;
  gap: 12rpx;
  margin-left: 12rpx;
}

.copy-button,
.share-button,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  max-width: 100%;
  height: 58rpx;
  border-radius: 999rpx;
  background: #e9f5ff;
  color: #2269a8;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.copy-button.room-header-button {
  min-width: 0;
  max-width: none;
  padding: 0;
  border: 2rpx solid rgba(61, 145, 220, 0.34);
  background: #ffffff;
  color: #1769a8;
  box-shadow: 0 8rpx 18rpx rgba(31, 112, 184, 0.16);
}

.copy-button.room-header-button.copy {
  width: 72rpx;
}

.copy-button.room-header-button.qr {
  width: 96rpx;
}

.batch-toggle {
  width: 104rpx;
  min-width: 0;
  padding: 0;
  background: #e6f8ee;
  color: #28764d;
  border: 0;
  font-weight: 800;
}

.batch-toggle.active {
  background: #47c982;
  color: #ffffff;
}

.transfer-toggle {
  width: 136rpx;
  min-width: 0;
  padding: 0;
  background: #e9f5ff;
  color: #256ba7;
  border: 0;
  font-weight: 800;
}

.transfer-toggle.active {
  background: #56a8f5;
  color: #ffffff;
}

.records-all-button {
  min-width: 132rpx;
  background: #ffffff;
  color: #1769a8;
  border: 2rpx solid rgba(61, 145, 220, 0.34);
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(31, 112, 184, 0.14);
}

.status-bar {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fff4e5;
  color: #955b12;
  font-size: 24rpx;
}

.status-bar.pending {
  background: #fff8dd;
  color: #7a5016;
}

.status-bar.removed {
  background: #f6efe4;
  color: #806647;
}

.score-panel {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #47c982, #2db56e);
  color: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(47, 160, 102, 0.22);
}

.score-panel-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-panel-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 22rpx rgba(31, 75, 48, 0.16);
}

.score-panel-actions {
  width: 100%;
}

.public-transfer-row {
  display: flex;
  width: 100%;
  margin-bottom: 12rpx;
}

.panel-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.public-score {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
}

.public-transfer-button,
.public-share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  min-width: 0;
  width: 100%;
  height: 54rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #278654;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.public-transfer-button.left {
  flex: 1;
  margin-right: 8rpx;
}

.public-transfer-button.right {
  flex: 1;
  margin-left: 8rpx;
}

.public-share-button {
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  color: #278654;
  border: 0;
}

.share-button {
  background: #ffffff;
  color: #1f7a5a;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.section-tools {
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 12rpx;
  width: 100%;
}

.section-title {
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.member-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 104rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-sizing: border-box;
}

.member-card.current-member {
  border-color: #47c982;
  background: linear-gradient(180deg, #e7f7ee, rgba(255, 255, 255, 0.9));
  box-shadow: 0 14rpx 30rpx rgba(47, 160, 102, 0.14);
}

.member-card.removed-member {
  background: #f7f1e7;
  opacity: 0.74;
}

.pending-list {
  margin-bottom: 14rpx;
}

.pending-card {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(255, 193, 7, 0.28);
  border-radius: 26rpx;
  background: #fff8dd;
  box-sizing: border-box;
}

.member-info {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.member-check {
  margin-right: 10rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  color: #3b260f;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(111, 74, 28, 0.12);
  box-sizing: border-box;
}

.member-avatar {
  width: 58rpx;
  height: 58rpx;
  font-size: 24rpx;
}

.avatar-yellow {
  background: linear-gradient(135deg, #ffe66d, #ffb23e);
}

.avatar-green {
  background: linear-gradient(135deg, #73d99d, #2bb56e);
  color: #ffffff;
}

.avatar-blue {
  background: linear-gradient(135deg, #8ac8ff, #4b92df);
  color: #ffffff;
}

.avatar-red {
  background: linear-gradient(135deg, #ff9a8a, #ef6558);
  color: #ffffff;
}

.avatar-muted {
  background: #f1e8d8;
  color: #8b7356;
}

.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fff2b0;
  color: #704812;
  font-size: 24rpx;
  font-weight: 700;
}

.member-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
}

.member-name {
  flex-shrink: 1;
  min-width: 0;
  color: #3b260f;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #704812;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.member-tag.current {
  background: #dff7e9;
  color: #23784d;
}

.member-tag.muted {
  background: #eee3d3;
  color: #806647;
}

.name-edit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 40rpx;
  margin: 0 0 0 10rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(71, 201, 130, 0.48);
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f7a4d;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 6rpx 14rpx rgba(31, 122, 77, 0.14);
  box-sizing: border-box;
}

.member-role {
  margin-top: 6rpx;
  color: #8a7358;
  font-size: 22rpx;
}

.member-score {
  flex-shrink: 0;
  min-width: 80rpx;
  font-size: 38rpx;
  font-weight: 700;
  text-align: right;
}

.score-positive {
  color: #12824f;
}

.score-negative {
  color: #c2412d;
}

.score-neutral {
  color: #3b260f;
}

.member-actions {
  display: flex;
  gap: 14rpx;
  width: 100%;
  margin-top: 18rpx;
}

.score-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0;
  padding: 0;
  height: 68rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.add {
  background: #e0f7ea;
  color: #218153;
  border: 0;
}

.subtract {
  background: #ffeae8;
  color: #cb463b;
  border: 0;
}

.transfer {
  background: #e7f3ff;
  color: #236ea9;
  border: 0;
}

.remove {
  background: #f6efe4;
  color: #806647;
  border: 0;
}

.compact-transfer {
  flex: 0 0 31%;
}

.batch-actions,
.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.batch-button,
.footer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-left: 0;
  margin-right: 0;
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.transfer-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(59, 38, 15, 0.42);
  box-sizing: border-box;
}

.qr-mask {
  position: fixed;
  z-index: 22;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(59, 38, 15, 0.42);
  box-sizing: border-box;
}

.qr-dialog {
  width: 100%;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #fffdf7;
  box-sizing: border-box;
}

.qr-title {
  color: #3b260f;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.qr-code-text {
  margin-top: 10rpx;
  color: #278654;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 0;
}

.qr-image-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 28rpx;
}

.qr-image {
  display: block;
  flex-shrink: 0;
  width: 464rpx;
  height: 464rpx;
  max-width: 100%;
  background: #ffffff;
  border: 2rpx solid rgba(90, 52, 24, 0.12);
  box-sizing: border-box;
}

.qr-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 464rpx;
  height: 464rpx;
  margin: 28rpx auto 0;
  border: 2rpx solid rgba(90, 52, 24, 0.12);
  background: #ffffff;
  color: #8a7358;
  font-size: 26rpx;
  box-sizing: border-box;
}

.qr-tip {
  margin-top: 18rpx;
  color: #8a7358;
  font-size: 24rpx;
  text-align: center;
}

.qr-close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;
  margin: 24rpx 0 0;
  border-radius: 18rpx;
  background: #fff2b0;
  color: #704812;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.transfer-dialog {
  width: 100%;
  max-height: 88vh;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffdf7;
  box-sizing: border-box;
  overflow: auto;
}

.dialog-head {
  margin-bottom: 22rpx;
}

.dialog-title {
  color: #3b260f;
  font-size: 32rpx;
  font-weight: 700;
}

.dialog-subtitle {
  margin-top: 8rpx;
  color: #8a7358;
  font-size: 23rpx;
  line-height: 1.45;
}

.dialog-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 18rpx;
  background: #fff8dd;
  color: #3b260f;
  font-size: 26rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.dialog-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin: 0;
  height: 70rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.dialog-button.primary {
  background: #47c982;
  color: #ffffff;
}

.dialog-button.secondary {
  background: #f6efe4;
  color: #6a4d2e;
}

.record-empty {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #8a7358;
  font-size: 26rpx;
  text-align: center;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-item.record-positive {
  border-left-color: #47c982;
}

.record-item.record-negative {
  border-left-color: #ff6b62;
}

.record-item.record-transfer {
  border-left-color: #56a8f5;
}

.record-item.record-undo {
  border-left-color: #9ca3af;
}

.record-title {
  color: #3b260f;
  font-size: 26rpx;
  font-weight: 800;
}

.record-operator {
  margin-top: 6rpx;
  color: #6a4d2e;
  font-size: 22rpx;
  line-height: 1.4;
}

.record-desc {
  margin-top: 8rpx;
  color: #8a7358;
  font-size: 23rpx;
  line-height: 1.45;
}

.record-amount {
  margin-left: 10rpx;
  font-weight: 700;
}

.record-amount.record-positive {
  color: #238456;
}

.record-amount.record-negative {
  color: #d34a3f;
}

.record-amount.record-transfer {
  color: #2672ae;
}

.record-amount.record-undo,
.record-amount.record-neutral {
  color: #8a7358;
}

.record-right {
  flex-shrink: 0;
  margin-left: 14rpx;
  text-align: right;
}

.record-time {
  color: #8a7358;
  font-size: 22rpx;
}

.undone {
  margin-top: 8rpx;
  color: #b42318;
  font-size: 22rpx;
}

.undo-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 0 auto;
  padding: 0 18rpx;
  min-width: 96rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #fff2b0;
  color: #704812;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.record-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.pager-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  width: 132rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #e9f5ff;
  color: #256ba7;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.pager-button[disabled] {
  background: #f6efe4;
  color: #b9afa3;
}

.pager-text {
  min-width: 76rpx;
  color: #6a4d2e;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.footer-button {
  background: #e7f7ee;
  color: #278654;
}

.danger {
  background: #ffeae8;
  color: #cb463b;
}

.loading {
  padding-top: 160rpx;
  color: #8a7358;
  font-size: 28rpx;
  text-align: center;
}

.empty-state {
  min-height: 100vh;
  padding: 180rpx 40rpx 0;
  background: #fffdf7;
  box-sizing: border-box;
  text-align: center;
}

.empty-title {
  color: #3b260f;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 16rpx;
  color: #8a7358;
  font-size: 26rpx;
  line-height: 1.55;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  margin: 34rpx 0 0;
  border-radius: 18rpx;
  background: #47c982;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}
