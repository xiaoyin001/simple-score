<view class="page" wx:if="{{!loading && room}}">
  <view class="room-header">
    <view>
      <view class="room-name">{{room.name}}</view>
      <view class="room-meta">房间码 {{room.roomCode}} · {{activeMemberCount}}/{{room.memberLimit}} 人 · 进入顺序</view>
      <view wx:if="{{showSyncStatus}}" class="sync-status {{syncStatusClass}}">{{syncStatusText}}</view>
    </view>
    <view class="room-header-actions">
      <button class="copy-button" bindtap="copyRoomCode">复制</button>
      <button class="copy-button" bindtap="showRoomQrCode">二维码</button>
    </view>
  </view>

  <view class="status-bar" wx:if="{{!isRoomOperable}}">
    当前房间已{{room.status === 'closed' ? '关闭' : '过期'}}，只能查看结果。
  </view>
  <view class="status-bar pending" wx:if="{{isRoomOperable && currentMemberStatus === 'pending'}}">
    你的加入申请正在等待房主确认，确认后才能参与记分。
  </view>
  <view class="status-bar removed" wx:if="{{currentMemberStatus === 'removed'}}">
    你已被移出该房间，历史记录仍可查看。
  </view>
  <view class="status-bar removed" wx:if="{{currentMemberStatus === 'rejected'}}">
    你的加入申请暂未通过，当前只能查看申请结果。
  </view>

  <view class="score-panel">
    <view class="score-panel-main">
      <view>
        <view class="panel-label">公共积分池</view>
        <view class="public-score">{{room.publicScore}}</view>
      </view>
      <image class="score-panel-icon" src="/assets/app-icon.png" mode="aspectFit" />
    </view>
    <view class="score-panel-actions">
      <view class="public-transfer-row" wx:if="{{canTransfer && isRoomOperable}}">
        <button class="public-transfer-button left" bindtap="openTransferToPublicDialog">转入</button>
        <button class="public-transfer-button right" bindtap="openTransferFromPublicDialog">转出</button>
      </view>
      <button class="public-share-button" open-type="share">分享房间</button>
    </view>
  </view>
  <view class="section">
    <view class="section-head">
      <view class="section-title">成员</view>
      <view class="section-tools">
        <button
          wx:if="{{canTransfer && isRoomOperable}}"
          class="text-button transfer-toggle {{transferMode ? 'active' : ''}}"
          bindtap="toggleTransferMode"
        >
          {{transferMode ? '取消转移' : '批量转移'}}
        </button>
        <button
          wx:if="{{isOwner && isRoomOperable}}"
          class="text-button batch-toggle {{batchMode ? 'active' : ''}}"
          bindtap="toggleBatchMode"
        >
          {{batchMode ? '取消批量' : '批量加扣'}}
        </button>
      </view>
    </view>

    <view class="pending-list" wx:if="{{isOwner && pendingMembers.length && isRoomOperable}}">
      <view class="pending-card" wx:for="{{pendingMembers}}" wx:key="_id">
        <view class="member-info">
          <view class="member-avatar avatar {{item.avatarTone}}">{{item.avatarText}}</view>
          <view class="member-main">
            <view class="member-name-row">
              <view class="member-name">{{item.nickname}}</view>
              <view class="member-tag">待确认</view>
            </view>
            <view class="member-role">申请加入</view>
          </view>
        </view>
        <view class="member-actions">
          <button
            class="score-action add"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            data-action="approve"
            bindtap="reviewJoinRequest"
          >
            同意加入
          </button>
          <button
            class="score-action remove"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            data-action="reject"
            bindtap="reviewJoinRequest"
          >
            暂不加入
          </button>
        </view>
      </view>
    </view>

    <checkbox-group bindchange="onMemberSelectChange">
      <view class="member-card {{item.isCurrent ? 'current-member' : ''}} {{item.isRemoved ? 'removed-member' : ''}}" wx:for="{{members}}" wx:key="_id">
        <view class="member-info">
          <label
            class="member-check"
            wx:if="{{isRoomOperable && item.canSelect && (batchMode || (transferMode && item._id !== currentMemberId))}}"
          >
            <checkbox value="{{item._id}}" color="#1f7a5a" />
          </label>
          <view class="member-avatar avatar {{item.avatarTone}}">{{item.avatarText}}</view>
          <view class="member-main">
            <view class="member-name-row">
              <view class="member-name">{{item.nickname}}</view>
              <view wx:if="{{item.isCurrent}}" class="member-tag current">我</view>
              <view wx:if="{{item.role === 'owner'}}" class="member-tag">房主</view>
              <view wx:if="{{item.isRemoved}}" class="member-tag muted">已移出</view>
              <view
                wx:if="{{item.canRename}}"
                class="name-edit-button"
                data-nickname="{{item.nickname}}"
                bindtap="updateNickname"
              >
                改名
              </view>
            </view>
            <view class="member-role">{{item.statusText}}</view>
          </view>
          <view class="member-score {{item.scoreTone}}">{{item.score}}</view>
        </view>
        <view class="member-actions" wx:if="{{isRoomOperable && item.isActive && !batchMode && !transferMode}}">
          <button
            wx:if="{{isOwner}}"
            class="score-action add"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            data-action="add"
            bindtap="updateMemberScore"
          >
            加
          </button>
          <button
            wx:if="{{isOwner}}"
            class="score-action subtract"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            data-action="subtract"
            bindtap="updateMemberScore"
          >
            扣
          </button>
          <button
            wx:if="{{canTransfer && item._id !== currentMemberId}}"
            class="score-action transfer {{!isOwner ? 'compact-transfer' : ''}}"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            bindtap="openMemberTransferDialog"
          >
            转
          </button>
          <button
            wx:if="{{isOwner && item._id !== currentMemberId && item.role !== 'owner'}}"
            class="score-action remove"
            data-member-id="{{item._id}}"
            data-nickname="{{item.nickname}}"
            bindtap="removeMember"
          >
            移出
          </button>
        </view>
      </view>
    </checkbox-group>

    <view class="batch-actions" wx:if="{{batchMode && isRoomOperable}}">
      <button class="batch-button add" data-action="add" bindtap="runBatch">批量加分</button>
      <button class="batch-button subtract" data-action="subtract" bindtap="runBatch">批量扣分</button>
    </view>
    <view class="batch-actions" wx:if="{{transferMode && isRoomOperable}}">
      <button class="batch-button transfer" bindtap="openBatchTransferDialog">转给所选成员</button>
    </view>
  </view>

  <view class="transfer-mask" wx:if="{{transferDialogVisible}}" catchtap="closeTransferDialog">
    <view class="transfer-dialog" catchtap="noop">
      <view class="dialog-head">
        <view>
          <view class="dialog-title">积分转移</view>
          <view class="dialog-subtitle">
            从{{transferSourceLabel}}转给 {{transferTargetSummary}}
          </view>
        </view>
      </view>
      <input
        class="dialog-input"
        type="number"
        placeholder="每个目标的分值"
        value="{{transferAmount}}"
        bindinput="onTransferAmountInput"
      />
      <view class="dialog-actions">
        <button class="dialog-button secondary" bindtap="closeTransferDialog">取消</button>
        <button class="dialog-button primary" bindtap="submitTransfer">确认转移</button>
      </view>
    </view>
  </view>

  <view class="qr-mask" wx:if="{{roomQrVisible}}" catchtap="closeRoomQrCode">
    <view class="qr-dialog" catchtap="noop">
      <view class="qr-title">房间二维码</view>
      <view class="qr-code-text">{{room.roomCode}}</view>
      <view class="qr-matrix">
        <view
          class="qr-row"
          wx:for="{{roomQrRows}}"
          wx:for-item="row"
          wx:key="key"
        >
          <view
            wx:for="{{row.cells}}"
            wx:for-item="cell"
            wx:key="key"
            class="qr-cell {{cell.dark ? 'dark' : ''}}"
          ></view>
        </view>
      </view>
      <view class="qr-tip">使用首页“扫码加入”扫描</view>
      <button class="qr-close-button" bindtap="closeRoomQrCode">关闭</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">最近记录</view>
      <button class="text-button records-all-button" bindtap="goRecords">全部</button>
    </view>
    <view class="record-empty" wx:if="{{!recentRecords.length}}">暂无记录</view>
    <view class="record-item {{item.toneClass}}" wx:for="{{recentRecords}}" wx:key="_id">
      <view class="record-main">
        <view class="record-title">{{item.displayType}}</view>
        <view class="record-operator">操作人：{{item.displayOperator}}</view>
        <view class="record-desc">
          {{item.displayTargets}}
          <text wx:if="{{item.amountText}}" class="record-amount {{item.toneClass}}">{{item.amountText}}</text>
        </view>
      </view>
      <view class="record-right">
        <view class="record-time">{{item.displayTime}}</view>
        <view class="undone" wx:if="{{item.isUndone}}">已撤销</view>
        <button
          wx:if="{{isOwner && isRoomOperable && item.canUndo}}"
          class="undo-button"
          data-record-id="{{item._id}}"
          data-title="{{item.displayType}}"
          bindtap="undoRecord"
        >
          撤销
        </button>
      </view>
    </view>
    <view class="record-pager" wx:if="{{showRecentRecordPager}}">
      <button
        class="pager-button"
        disabled="{{!canPrevRecentRecordPage}}"
        data-direction="prev"
        bindtap="changeRecentRecordPage"
      >
        上一页
      </button>
      <view class="pager-text">{{recentRecordPageText}}</view>
      <button
        class="pager-button"
        disabled="{{!canNextRecentRecordPage}}"
        data-direction="next"
        bindtap="changeRecentRecordPage"
      >
        下一页
      </button>
    </view>
  </view>

  <view class="footer-actions" wx:if="{{isOwner && isRoomOperable}}">
    <button class="footer-button danger" bindtap="closeRoom">关闭房间</button>
  </view>
</view>

<view class="empty-state" wx:elif="{{!loading && loadFailed}}">
  <view class="empty-title">房间不可用</view>
  <view class="empty-desc">{{loadErrorText}}</view>
  <button class="empty-button" bindtap="goHome">返回首页</button>
</view>

<view class="loading" wx:else>加载中...</view>
