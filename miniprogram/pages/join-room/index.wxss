page {
  background:
    linear-gradient(180deg, rgba(255, 225, 86, 0.42), rgba(255, 253, 247, 0.94) 360rpx),
    #fffdf7;
}

.page {
  min-height: 100vh;
  padding: 44rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.head-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(111, 74, 28, 0.14);
}

.title {
  color: #3b260f;
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 12rpx;
  color: #765839;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.form {
  margin-top: 34rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 30rpx rgba(111, 74, 28, 0.08);
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #6a4d2e;
  font-size: 26rpx;
  font-weight: 800;
}

.input {
  height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 20rpx;
  background: #fff8dd;
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.code-input {
  letter-spacing: 4rpx;
  font-weight: 700;
}

.hint {
  margin-top: 10rpx;
  color: #8a7358;
  font-size: 22rpx;
}

.join-mascot {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #eaf8f0;
  color: #32714e;
}

.join-mascot-image {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
}

.join-mascot-text {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 34rpx;
  margin-left: 0;
  margin-right: 0;
  height: 92rpx;
  border-radius: 22rpx;
  background: #47c982;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: inset 0 -5rpx rgba(90, 52, 24, 0.12);
}
