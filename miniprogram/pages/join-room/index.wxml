<view class="page">
  <view class="page-head">
    <view>
      <view class="title">加入房间</view>
      <view class="subtitle">输入房间码，或通过分享链接自动带入房间信息。</view>
    </view>
    <image class="head-icon" src="/assets/app-icon.png" mode="aspectFit" />
  </view>

  <view class="form">
    <view class="field">
      <view class="label">房间码</view>
      <input
        class="input code-input"
        maxlength="12"
        placeholder="请输入 6 位房间码"
        value="{{roomCode}}"
        data-field="roomCode"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="label">我的昵称</view>
      <input
        class="input"
        maxlength="20"
        placeholder="不填则自动生成"
        value="{{nickname}}"
        data-field="nickname"
        bindinput="onInput"
      />
      <view class="hint">默认名已带入，可临时修改</view>
    </view>
  </view>

  <view class="join-mascot">
    <image class="join-mascot-image" src="/assets/app-icon.png" mode="aspectFit" />
    <view class="join-mascot-text">加入后可查看成员积分和最近记录。</view>
  </view>

  <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
    加入房间
  </button>
</view>
