page {
  background:
    linear-gradient(180deg, rgba(255, 225, 86, 0.42), rgba(255, 253, 247, 0.94) 360rpx),
    #fffdf7;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 34rpx 0 22rpx;
}

.hero-icon {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(111, 74, 28, 0.12);
}

.hero-copy {
  flex: 0 0 304rpx;
  width: 304rpx;
  min-width: 0;
  box-sizing: border-box;
}

.app-name {
  color: #3b260f;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.2;
}

.tagline-row {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tagline-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  height: 76rpx;
}

.tagline {
  color: #765839;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.badge {
  flex-shrink: 0;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #7a5016;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  gap: 10rpx;
  width: 124rpx;
  height: 124rpx;
}

.hero-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 57rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
  box-shadow: inset 0 -4rpx rgba(90, 52, 24, 0.12);
}

.hero-action-create {
  background: #ffd93d;
  color: #55340f;
}

.hero-action-join {
  background: #47c982;
  color: #ffffff;
}

.hero-action-scan {
  flex-direction: column;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: #e7f3ff;
  color: #2469a8;
  font-size: 19rpx;
  line-height: 1.18;
}

.hero-action-scan text + text {
  margin-top: 4rpx;
}

.default-name-panel {
  margin-top: 6rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(111, 74, 28, 0.08);
}

.default-name-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.default-name-title {
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 800;
}

.default-name-subtitle {
  margin-top: 6rpx;
  color: #765839;
  font-size: 23rpx;
  font-weight: 600;
}

.profile-preview {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  color: #3b260f;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(111, 74, 28, 0.12);
  box-sizing: border-box;
}

.avatar-yellow {
  background: linear-gradient(135deg, #ffe66d, #ffb23e);
}

.avatar-green {
  background: linear-gradient(135deg, #73d99d, #2bb56e);
  color: #ffffff;
}

.avatar-blue {
  background: linear-gradient(135deg, #8ac8ff, #4b92df);
  color: #ffffff;
}

.avatar-red {
  background: linear-gradient(135deg, #ff9a8a, #ef6558);
  color: #ffffff;
}

.avatar-muted {
  background: #f1e8d8;
  color: #8b7356;
}

.default-name-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 25rpx;
}

.default-name-input {
  flex: 0 1 auto;
  width: 400rpx;
  min-width: 0;
  height: 66rpx;
  padding: 0 18rpx;
  border: 3rpx solid #d8a33a;
  border-radius: 14rpx;
  background: #ffffff;
  color: #3b260f;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 2rpx rgba(255, 217, 61, 0.28), 0 6rpx 12rpx rgba(111, 74, 28, 0.08);
  box-sizing: border-box;
}

.default-name-save {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 110rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 3rpx solid #2fb872;
  border-radius: 14rpx;
  background: #47c982;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 6rpx 12rpx rgba(47, 184, 114, 0.18), inset 0 -4rpx rgba(21, 122, 70, 0.18);
  box-sizing: border-box;
}

.default-name-save.disabled {
  border-color: #d9e5dc;
  background: #eef5f0;
  color: #a5b0a8;
  box-shadow: none;
}

.default-name-hint {
  margin-top: 12rpx;
  color: #8a7358;
  font-size: 22rpx;
}

.default-name-hint.error {
  color: #b42318;
}

.section {
  margin-top: 36rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 800;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 3rpx solid #d8a33a;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 18rpx rgba(111, 74, 28, 0.08);
}

.recent-active {
  border-color: #25a968;
  background: #f1fff7;
}

.recent-pending {
  border-color: #e0a21b;
  background: #fff8dd;
}

.recent-expired {
  border-color: #4d8ed8;
  background: #f0f7ff;
}

.recent-closed,
.recent-removed {
  border-color: #9a856b;
  background: #f6f1e8;
}

.recent-rejected {
  border-color: #d65b4f;
  background: #fff1ef;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.recent-name {
  flex: 1;
  min-width: 0;
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
}

.status-active {
  background: #dff8eb;
  color: #147a47;
}

.status-pending {
  background: #ffe7a6;
  color: #8a5a00;
}

.status-expired {
  background: #dcefff;
  color: #2469a8;
}

.status-closed,
.status-removed {
  background: #e7ddd0;
  color: #6c5640;
}

.status-rejected {
  background: #ffd9d5;
  color: #a33b31;
}

.recent-code {
  margin-top: 8rpx;
  color: #8a7358;
  font-size: 24rpx;
}

.recent-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #25a968;
  color: #ffffff;
  font-weight: 800;
  font-size: 25rpx;
  line-height: 1;
  box-shadow: 0 8rpx 16rpx rgba(37, 169, 104, 0.24), inset 0 -4rpx rgba(21, 122, 70, 0.22);
  box-sizing: border-box;
}

.load-more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78rpx;
  margin: 8rpx 0 0;
  padding: 0;
  border: 3rpx solid #e0a21b;
  border-radius: 20rpx;
  background: #ffe7a6;
  color: #6f4700;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 8rpx 16rpx rgba(122, 80, 22, 0.16), inset 0 -4rpx rgba(122, 80, 22, 0.12);
  box-sizing: border-box;
}

.load-more-button::after {
  border: 0;
}

.load-more-button[disabled] {
  border-color: #d8c8ae;
  background: #f1e8d8;
  color: #9a856b;
  box-shadow: none;
}

.list-loading {
  padding: 10rpx 0 2rpx;
  color: #8a7358;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.notice {
  margin-top: 36rpx;
  color: #8a7358;
  font-size: 26rpx;
  line-height: 1.7;
}
