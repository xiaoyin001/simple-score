page {
  background:
    linear-gradient(180deg, rgba(255, 225, 86, 0.42), rgba(255, 253, 247, 0.94) 360rpx),
    #fffdf7;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 34rpx 0 22rpx;
}

.hero-icon {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(111, 74, 28, 0.12);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.app-name {
  color: #3b260f;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
}

.tagline-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.tagline {
  color: #765839;
  font-size: 28rpx;
  font-weight: 600;
}

.badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #7a5016;
  font-size: 24rpx;
  font-weight: 800;
}

.default-name-panel {
  margin-top: 6rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(111, 74, 28, 0.08);
}

.default-name-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.default-name-title {
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 800;
}

.default-name-subtitle {
  margin-top: 6rpx;
  color: #765839;
  font-size: 23rpx;
  font-weight: 600;
}

.default-name-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #7a5016;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-preview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(111, 74, 28, 0.12);
  box-sizing: border-box;
}

.avatar-yellow {
  background: linear-gradient(135deg, #ffe66d, #ffb23e);
}

.avatar-green {
  background: linear-gradient(135deg, #73d99d, #2bb56e);
  color: #ffffff;
}

.avatar-blue {
  background: linear-gradient(135deg, #8ac8ff, #4b92df);
  color: #ffffff;
}

.avatar-red {
  background: linear-gradient(135deg, #ff9a8a, #ef6558);
  color: #ffffff;
}

.avatar-muted {
  background: #f1e8d8;
  color: #8b7356;
}

.profile-preview-name {
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-preview-desc {
  margin-top: 6rpx;
  color: #8a7358;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.default-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.default-name-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #fff8dd;
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.default-name-save {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 108rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #47c982;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.default-name-save::after {
  border: 0;
}

.default-name-save[disabled] {
  background: #cbead8;
  color: #ffffff;
}

.default-name-hint {
  margin-top: 12rpx;
  color: #8a7358;
  font-size: 22rpx;
}

.default-name-hint.error {
  color: #b42318;
}

.action-panel {
  margin-top: 28rpx;
}

.primary-button,
.secondary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin-left: 0;
  margin-right: 0;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: inset 0 -5rpx rgba(90, 52, 24, 0.12);
}

.primary-button {
  background: #ffd93d;
  color: #55340f;
}

.secondary-button {
  margin-top: 18rpx;
  background: #47c982;
  color: #ffffff;
}

.ghost-button {
  margin-top: 18rpx;
  background: #e7f3ff;
  color: #2469a8;
}

.section {
  margin-top: 36rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 800;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
}

.recent-name {
  color: #3b260f;
  font-size: 30rpx;
  font-weight: 600;
}

.recent-code {
  margin-top: 8rpx;
  color: #8a7358;
  font-size: 24rpx;
}

.recent-arrow {
  color: #278654;
  font-weight: 800;
  font-size: 26rpx;
}

.load-more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  margin: 6rpx 0 0;
  padding: 0;
  border-radius: 18rpx;
  background: #fff8dd;
  color: #7a5016;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.load-more-button::after {
  border: 0;
}

.load-more-button[disabled] {
  background: #f1e8d8;
  color: #9a856b;
}

.list-loading {
  padding: 10rpx 0 2rpx;
  color: #8a7358;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.notice {
  margin-top: 36rpx;
  color: #8a7358;
  font-size: 26rpx;
  line-height: 1.7;
}
