<view class="page">
  <view class="hero">
    <image class="hero-icon" src="/assets/app-icon.png" mode="aspectFit" />
    <view class="hero-copy">
      <view class="app-name">简单记分鸭</view>
      <view class="tagline-row">
        <view class="tagline">多人活动记分工具</view>
        <view class="badge">最多 12 人</view>
      </view>
    </view>
  </view>

  <view class="default-name-panel">
    <view class="default-name-head">
      <view>
        <view class="default-name-title">当前用户</view>
        <view class="default-name-subtitle">创建或加入房间时自动带入</view>
      </view>
      <view class="default-name-status">{{profileSavedName ? '已保存' : '未保存'}}</view>
    </view>
    <view class="profile-preview">
      <view class="avatar {{profileAvatar.avatarTone}}">{{profileAvatar.avatarText}}</view>
      <view>
        <view class="profile-preview-name">{{profileDraftName || profileFallbackName}}</view>
        <view class="profile-preview-desc">头像和默认名会带入房间</view>
      </view>
    </view>
    <view class="default-name-row">
      <input
        class="default-name-input"
        type="nickname"
        maxlength="20"
        disabled="{{profileSaving}}"
        placeholder="例如：小明"
        value="{{profileDraftName}}"
        bindinput="onProfileDraftInput"
      />
      <button
        class="default-name-save"
        loading="{{profileSaving}}"
        disabled="{{profileSaving || !profileDraftName}}"
        bindtap="saveProfileName"
      >
        {{profileSaving ? '保存中' : '保存'}}
      </button>
    </view>
    <view class="default-name-hint {{profileError ? 'error' : ''}}">
      {{profileError || '点击保存后，创建或加入房间会使用这个名称'}}
    </view>
  </view>

  <view class="action-panel">
    <button class="primary-button" bindtap="goCreate">创建房间</button>
    <button class="secondary-button" bindtap="goJoin">输入房间码</button>
    <button class="ghost-button" bindtap="scanJoin">扫码加入</button>
  </view>

  <view class="section" wx:if="{{recentRooms.length}}">
    <view class="section-title">已加入房间</view>
    <view
      class="recent-item recent-{{item.statusTone}}"
      wx:for="{{recentRooms}}"
      wx:key="roomId"
      bindtap="goRoom"
      data-room-id="{{item.roomId}}"
    >
      <view class="recent-main">
        <view class="recent-title-row">
          <view class="recent-name">{{item.name}}</view>
          <view class="recent-status status-{{item.statusTone}}">{{item.statusLabel}}</view>
        </view>
        <view class="recent-code">房间码 {{item.roomCode}}</view>
      </view>
      <view class="recent-arrow">进入</view>
    </view>
    <button
      class="load-more-button"
      wx:if="{{homeHasMore}}"
      loading="{{homeLoading}}"
      disabled="{{homeLoading}}"
      bindtap="loadMoreRooms"
    >
      {{homeLoading ? '加载中' : '加载更多'}}
    </button>
    <view class="list-loading" wx:elif="{{homeLoading}}">加载中</view>
  </view>

  <view class="notice">
    简单记分鸭适用于聚会小游戏、桌游、亲子任务和团队活动，快速创建房间并记录积分变化。
  </view>
</view>
