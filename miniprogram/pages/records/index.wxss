page {
  background: #f4f5f7;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.empty,
.loading {
  margin-top: 40rpx;
  padding: 36rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #8b95a1;
  font-size: 26rpx;
  text-align: center;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
}

.record-card.record-positive {
  border-left-color: #1f9d63;
}

.record-card.record-negative {
  border-left-color: #d64532;
}

.record-card.record-transfer {
  border-left-color: #2f80c4;
}

.record-card.record-undo {
  border-left-color: #9ca3af;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-type {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.record-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #8b95a1;
  font-size: 22rpx;
}

.record-line,
.record-remark {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-remark {
  color: #6b7280;
}

.record-amount {
  font-weight: 700;
}

.record-amount.record-positive {
  color: #12824f;
}

.record-amount.record-negative {
  color: #c2412d;
}

.record-amount.record-transfer {
  color: #2f80c4;
}

.record-amount.record-undo,
.record-amount.record-neutral {
  color: #6b7280;
}

.undone {
  margin-top: 14rpx;
  color: #b42318;
  font-size: 24rpx;
}

.undo-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 18rpx 0 0;
  padding: 0 22rpx;
  width: 100%;
  height: 62rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}
