page {
  background: #f4f5f7;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.title {
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.empty,
.loading {
  margin-top: 40rpx;
  padding: 36rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #8b95a1;
  font-size: 26rpx;
  text-align: center;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-type {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.record-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #8b95a1;
  font-size: 22rpx;
}

.record-line,
.record-remark {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-remark {
  color: #6b7280;
}

.undone {
  margin-top: 14rpx;
  color: #b42318;
  font-size: 24rpx;
}
