page {
  background:
    linear-gradient(180deg, rgba(255, 225, 86, 0.42), rgba(255, 253, 247, 0.94) 360rpx),
    #fffdf7;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  color: #3b260f;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  color: #765839;
  font-size: 24rpx;
  font-weight: 600;
}

.record-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff2b0;
  color: #7a5016;
  font-size: 22rpx;
  font-weight: 800;
}

.empty,
.loading {
  margin-top: 40rpx;
  padding: 36rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #8a7358;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.empty-icon {
  display: block;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 18rpx;
  border-radius: 30rpx;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(90, 52, 24, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border-left: 8rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 10rpx 22rpx rgba(111, 74, 28, 0.06);
}

.record-card.record-positive {
  border-left-color: #47c982;
}

.record-card.record-negative {
  border-left-color: #ff6b62;
}

.record-card.record-transfer {
  border-left-color: #56a8f5;
}

.record-card.record-undo {
  border-left-color: #9ca3af;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-type {
  color: #3b260f;
  font-size: 28rpx;
  font-weight: 800;
}

.record-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #8a7358;
  font-size: 22rpx;
}

.record-line,
.record-remark {
  margin-top: 8rpx;
  color: #6a4d2e;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-remark {
  color: #8a7358;
}

.record-amount {
  font-weight: 700;
}

.record-amount.record-positive {
  color: #238456;
}

.record-amount.record-negative {
  color: #d34a3f;
}

.record-amount.record-transfer {
  color: #2672ae;
}

.record-amount.record-undo,
.record-amount.record-neutral {
  color: #8a7358;
}

.undone {
  margin-top: 14rpx;
  color: #b42318;
  font-size: 24rpx;
}

.undo-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 18rpx 0 0;
  padding: 0 22rpx;
  width: 100%;
  height: 62rpx;
  border-radius: 18rpx;
  background: #fff2b0;
  color: #704812;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.records-footer {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #fff8dd;
  color: #6a4d2e;
}

.footer-icon {
  flex-shrink: 0;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
}

.footer-text {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}
